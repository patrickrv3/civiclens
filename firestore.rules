rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Bill summaries cache (AI-generated) ──────────────────────────────
    // Read: any authenticated user (feed cards use these)
    // Write: server only via Admin SDK (bypasses rules — deny client writes)
    match /billSummaries/{billId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── User data ─────────────────────────────────────────────────────────
    // All user data is scoped strictly to the authenticated owner
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Watched bills — only the owner can read/write
      match /watchedBills/{billId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Subscription status — owner can READ only
      // Writes come exclusively from the server (Stripe webhook via Admin SDK)
      match /subscription/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; // Admin SDK bypasses this — client writes blocked
      }
    }

    // Block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
