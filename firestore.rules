rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Bill summaries cache (AI-generated public data) ──────────────────────
    // Open read/write — server routes use client SDK without auth context.
    // This is AI summaries of public legislation only (no user data).
    match /billSummaries/{billId} {
      allow read: if true;
      allow write: if true;
    }

    // ── User data ─────────────────────────────────────────────────────────────
    // All user data is scoped strictly to the authenticated owner
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Watched bills — only the owner can read/write
      match /watchedBills/{billId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Subscription status — owner can READ only
      // Writes come exclusively from the server (Stripe webhook via Admin SDK)
      match /subscription/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; // Admin SDK bypasses this — client writes blocked
      }
    }

    // Block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
